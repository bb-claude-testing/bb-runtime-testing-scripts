#!/bin/bash

echo -e `date +"%Y-%m-%d %H:%M:%S"` "\e[92m[T1552.001] This rule detects attempts to steal Azure Credentials using find or grep commands. An attacker could obtain sensitive Azure data, such as private keys, leading to unauthorized access to critical resources.\e[m"
# Search for the Azure CLI credential files (original was missing -name and just listed /root)
find /root /home -name "azure.json" -o -name "accessTokens.json" -o -name "azureProfile.json" 2> /dev/null
