#!/bin/bash

echo -e `date +"%Y-%m-%d %H:%M:%S"` "\e[92m[T1014] eBPF program load: a single BPF program is loaded into the kernel via bpf(BPF_PROG_LOAD). Rootkits/implants abuse eBPF to hook syscalls, hide processes, and tap traffic. Requires CAP_BPF/CAP_SYS_ADMIN.\033[m"
# SIMULATION ONLY: loads exactly ONE trivial, valid BPF program (mov r0,0; exit) via a
# single bpf(BPF_PROG_LOAD) syscall -> one detection. (The previous 'bpftool feature probe'
# issued dozens of BPF_PROG_LOADs, producing ~50 detections.)
python3 - <<'PY'
import ctypes, struct, platform
libc = ctypes.CDLL("libc.so.6", use_errno=True)
insns = struct.pack("<BBhi", 0xb7, 0, 0, 0) + struct.pack("<BBhi", 0x95, 0, 0, 0)  # mov r0,0 ; exit
insns_buf = ctypes.create_string_buffer(insns, len(insns))
lic = ctypes.create_string_buffer(b"GPL")
class Attr(ctypes.Structure):
    _fields_ = [("prog_type", ctypes.c_uint), ("insn_cnt", ctypes.c_uint),
                ("insns", ctypes.c_ulonglong), ("license", ctypes.c_ulonglong),
                ("log_level", ctypes.c_uint), ("log_size", ctypes.c_uint),
                ("log_buf", ctypes.c_ulonglong), ("kern_version", ctypes.c_uint),
                ("prog_flags", ctypes.c_uint)]
a = Attr(); a.prog_type = 1; a.insn_cnt = 2   # BPF_PROG_TYPE_SOCKET_FILTER
a.insns = ctypes.cast(insns_buf, ctypes.c_void_p).value
a.license = ctypes.cast(lic, ctypes.c_void_p).value
sysnum = 321 if platform.machine() == "x86_64" else 280   # bpf(2): x86_64=321, arm64=280
fd = libc.syscall(sysnum, 5, ctypes.byref(a), ctypes.sizeof(a))  # cmd 5 = BPF_PROG_LOAD
print("  bpf(BPF_PROG_LOAD) -> fd=%d errno=%d" % (fd, ctypes.get_errno()))
PY
