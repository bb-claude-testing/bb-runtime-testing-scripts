#!/bin/bash

echo -e `date +"%Y-%m-%d %H:%M:%S"` "\e[92m[T1552.001] Secret harvesting from /proc: reading other processes' environ and cmdline files to scrape credentials, tokens, and secrets passed via environment variables.\033[m"
# SIMULATION ONLY: read-only reads of process environ/cmdline; output discarded. No
# secrets are stored or transmitted -- the access pattern is the detection signal.
for f in /proc/1/environ /proc/1/cmdline /proc/self/environ; do
  cat "$f" >/dev/null 2>&1
done
echo "  (read /proc/*/environ and /proc/*/cmdline -- credential-harvesting signal)"
