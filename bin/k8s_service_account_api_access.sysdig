#!/bin/bash

echo -e `date +"%Y-%m-%d %H:%M:%S"` "\e[92m[T1078.004] Kubernetes service account abuse: using the pod's mounted service-account token to call the Kubernetes API server. Stolen tokens let an attacker enumerate or modify cluster resources.\033[m"
SA=/var/run/secrets/kubernetes.io/serviceaccount
if [ -f "$SA/token" ]; then
  TOKEN=$(cat "$SA/token")
  curl -s -m3 --cacert "$SA/ca.crt" \
    --header "Authorization: Bearer $TOKEN" \
    -X GET https://kubernetes.default.svc/api/v1/namespaces/$(cat "$SA/namespace")/pods >/dev/null 2>&1
else
  echo "(no service account token mounted — run this as a Pod in a Kubernetes cluster for a full simulation)"
fi
